{
  "name": "tokpure",
  "productName": "TokPure",
  "version": "2.4.0",
  "description": "TokPure — TikTok local video engine & no-watermark downloader",
  "main": "electron/main.js",
  "author": "TokPure",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.tokpure.desktop",
    "productName": "TokPure",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "extraResources": [
        {
          "from": "resources/bin/ffmpeg",
          "to": "resources/bin/ffmpeg"
        }
      ]
    },
    "dmg": {
      "title": "TokPure Installer",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin/ffmpeg.exe",
          "to": "resources/bin/ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TokPure"
    }
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
